# Local development (.env or .env.local — not committed). Production values live in .env.production.
# Backend API including the /api prefix. Leave empty (or point at a stopped server) to run on local dummy data.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Public site URL (metadata / Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3001
# WhatsApp number for orders/enquiries, international format without "+"
NEXT_PUBLIC_WHATSAPP_PHONE=97433367169
# Admin panel app (Imprimo-admin). /admin on this site redirects there.
ADMIN_URL=http://localhost:3000
# Optional — shown in the footer only when set (verified values only)
NEXT_PUBLIC_CONTACT_EMAIL=
